# Server-side provider credentials. Copy to .env and supply real values locally.
YOU_API_KEY=
DAYTONA_API_KEY=
LLM_API_KEY=

# Configure these from the approved One developer application. Do not infer
# endpoints or scopes; they are intentionally not encoded in this file.
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_REDIRECT_URI=http://localhost:8000/auth/one/callback
ONE_AUTHORIZATION_URL=
ONE_TOKEN_URL=
SESSION_SECRET=

# Persistence
DATABASE_URL=sqlite:///./bk_exp.db
